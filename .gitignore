# ===========================================
# Coupon Assignment ML - .gitignore
# ===========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual environments
venv/
env/
ENV/
.venv/
.env/

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Environment variables
.env
.env.local
.env.*.local

# IDE settings
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Project specific
*.log
*.tmp
*.temp

# Large data files (uncomment if needed)
# *.csv
# *.json
# *.joblib

# Model files (uncomment to exclude from git)
# models/
# *.joblib
# *.pkl
# *.h5

# Matplotlib figures
*.png
*.jpg
*.jpeg
*.gif
*.svg

# Security
*.pem
*.key
credentials.json
service_account.json

# User data files (contain PII)
train_Userlog.json
test_Userlog.json
generated_Userlog.json
log.json
*.pyc
.mcp.json
